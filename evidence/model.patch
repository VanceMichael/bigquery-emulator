++func rehydrateRow(row *internaltypes.TableRow, fields []*bigqueryv2.TableFieldSchema) {
++	for idx, cell := range row.F {
++		var field *bigqueryv2.TableFieldSchema
++		if idx < len(fields) {
++			field = fields[idx]
++		}
++		rehydrateCell(cell, field)
++	}
++}
