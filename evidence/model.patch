++++	)
++++	target := fmt.Sprintf("%s/datasets/%s/tables", cacheBase(base), cacheDatasetID)
++++	if code, resp := httpJSON(t, http.MethodPost, target, body, nil); code != http.StatusOK {
++++		t.Fatalf("create table %s: %d (%v)", table, code, resp)
++++	}
++++}
