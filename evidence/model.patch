++	createTableREST(t, ts, projectID, datasetID, "explicit", time.Now().Add(2*time.Hour).UnixMilli())
++	createViewREST(t, ts, projectID, datasetID, "a_view", 0)
++	after := time.Now().UnixMilli()
++
