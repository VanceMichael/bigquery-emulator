++// dedupeRefs drops references identical in kind and parts, preserving order.
++func dedupeRefs(refs []Ref) []Ref {
++	seen := map[string]bool{}
++	out := make([]Ref, 0, len(refs))
++	for _, ref := range refs {
++		key := refKey(ref)
++		if seen[key] {
++			continue
++		}
++		seen[key] = true
++		out = append(out, ref)
++	}
++	return out
++}
