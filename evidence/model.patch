+++// TestExpirationPatchClearAndOverride: PATCH can clear (null) or override the
+++// expiration; the sweeper honors the updated value.
+++func TestExpirationPatchClearAndOverride(t *testing.T) {
+++	const (
+++		projectID = "test"
+++		datasetID = "ds_patch"
