+++				return parts, i + 1, false, true, true
+++			}
+++			continue
+++		}
+++		break
+++	}
+++	if len(parts) == 0 {
+++		return nil, start, false, false, false
+++	}
+++	if i < len(tokens) && tokens[i].kind == tkPunct && tokens[i].text == "(" {
+++		isCall = true
+++	}
+++	return parts, i, isCall, wildcard, true
+++}
