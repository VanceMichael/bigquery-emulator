+	if err != nil {
+		return err
+	}
+	tx, err := conn.Begin(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.RollbackIfNotCommitted()
+	_, err = s.contentRepo.Query(ctx, tx, projectID, datasetID, query, nil)
+	return err
