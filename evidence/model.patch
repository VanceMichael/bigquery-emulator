++++func cacheQueryHit(t *testing.T, base, sql string) (map[string]any, bool) {
++++	t.Helper()
++++	resp := cacheQuery(t, base, sql, nil)
++++	hit, _ := resp["cacheHit"].(bool)
++++	return resp, hit
++++}
