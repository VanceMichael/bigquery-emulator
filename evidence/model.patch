+++		j.content.Status = &bigqueryv2.JobStatus{}
+++	}
+++	if j.content.Status.ErrorResult == nil {
+++		j.content.Status.State = "DONE"
+++		j.content.Status.ErrorResult = &bigqueryv2.ErrorProto{
