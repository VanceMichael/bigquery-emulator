++		CacheKey:     key,
++		ProjectID:    projectID,
++		Response:     string(responseJSON),
++		Dependencies: string(depsJSON),
++		CreatedAt:    time.Now().Unix(),
++	}); err != nil {
++		logger.Logger(ctx).Warn("query cache: failed to store entry", zap.Error(err))
++	}
