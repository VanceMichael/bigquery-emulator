+++// splitStatements breaks tokens into statements at depth-0 semicolons.
+++func splitStatements(tokens []token) [][]token {
+++	var (
+++		out        [][]token
+++		cur        []token
+++		depth      int
+++	)
+++	for _, t := range tokens {
+++		if t.kind == tkPunct {
+++			switch t.text {
+++			case "(":
+++				depth++
+++			case ")":
+++				depth--
+++			case ";":
+++				if depth == 0 {
+++					if len(cur) > 0 {
+++						out = append(out, cur)
+++						cur = nil
+++					}
+++					continue
+++				}
+++			}
+++		}
+++		cur = append(cur, t)
+++	}
+++	if len(cur) > 0 {
+++		out = append(out, cur)
+++	}
+++	return out
+++}
