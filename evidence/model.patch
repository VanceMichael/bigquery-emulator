+diff --git a/internal/metadata/job.go b/internal/metadata/job.go
+index 2e88c0c..e951f93 100644
+--- a/internal/metadata/job.go
++++ b/internal/metadata/job.go
+@@ -65,8 +65,33 @@ func (j *Job) Wait(ctx context.Context) (*internaltypes.QueryResponse, error) {
+ 	}
